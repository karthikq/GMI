{
  "services": {
    "news": {
      "root": "news",
      "framework": "nextjs"
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": {
        "service": "news"
      }
    },
    {
      "source": "/api/archive(.*)",
      "destination": {
        "service": "news"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "news"
      }
    }
  ]
}
